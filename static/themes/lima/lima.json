{
	"name": "Lima",
	"author": "CubicLauncher",
	"version": "1.1",
	"type": "builtin",
	"bg_image": "/themes/lima/lima.webp",
	"bg_image_blur": 5.0,
	"bg_image_opacity": 0.25,
	"variables": {
		"--color-scheme": "dark",
		"--bg-image-brightness": "0.35",
		"--bg-main": "#0a0f0a",
		"--bg-sidebar": "#0c110c",
		"--bg-card": "#121a12",
		"--bg-item-active": "#162016",
		"--bg-overlay": "rgba(0,10,0,0.75)",
		"--bg-input": "#161e16",

		"--bg-sidebar-gradient": "linear-gradient(180deg, #0c110c 0%, #0a0f0a 100%)",
		"--bg-card-gradient": "linear-gradient(135deg, rgba(151,196,89,0.04) 0%, rgba(151,196,89,0) 100%)",

		"--text-primary": "#e0ecd4",
		"--text-secondary": "#b7cbaa",
		"--text-muted": "#98aa8e",
		"--border": "var(--border-color)",
		"--border-color": "#40523a",
		"--border-hover": "#657b59",
		"--border-focus": "var(--accent)",
		"--control-focus-shadow": "0 0 0 3px rgba(151,196,89,0.2)",
		"--border-width": "1px",
		"--border-radius": "8px",
		"--border-radius-sm": "4px",
		"--border-radius-lg": "12px",
		"--accent": "#97C459",
		"--accent-rgb": "151,196,89",
		"--accent-hover": "#a8d06a",
		"--accent-text": "#0a1a04",
		"--accent-primary": "#97C459",
		"--shadow-sm": "0 1px 3px rgba(0,0,0,0.5)",
		"--shadow-md": "0 4px 12px rgba(0,0,0,0.6)",
		"--shadow-lg": "0 8px 28px rgba(0,0,0,0.7)",
		"--glow-accent": "0 0 12px rgba(151,196,89,0.2)",
		"--glow-error": "0 0 12px rgba(var(--color-error-rgb),0.3)",
		"--glow-success": "0 0 12px rgba(151,196,89,0.3)",
		"--color-success": "#97C459",
		"--color-success-rgb": "151,196,89",
		"--color-error": "#ff817a",
		"--color-error-rgb": "255,129,122",
		"--color-warning": "#d29922",
		"--color-warning-rgb": "210,153,34",
		"--color-info": "#8ab4e8",
		"--color-info-rgb": "138,180,232",
		"--color-on-success": "#0a1a04",
		"--color-on-error": "#0a1a04",
		"--color-on-warning": "#0a1a04",
		"--color-on-info": "#0a1a04",
		"--color-status-starting": "var(--color-info)",
		"--color-status-started": "#97C459",
		"--icon-filter": "invert(0.8) sepia(1) saturate(0.5) hue-rotate(60deg)",
		"--icon-filter-error": "invert(16%) sepia(89%) saturate(4668%) hue-rotate(0deg) brightness(96%) contrast(112%)",
		"--cubic-logo": "url(\"/images/cubic-white.svg\")",
		"--cubic-logo-fallback": "url(\"/images/cubic-white.svg\")",

		"--clr-loader-vanilla": "#78909c",
		"--clr-loader-fabric": "#66bb6a",
		"--clr-loader-forge": "#ffa726",
		"--clr-loader-quilt": "#c77dd6",

		"--sidebar-width": "260px",

		"--scrollbar-track": "#0a0f0a",
		"--scrollbar-thumb": "#657b59",
		"--scrollbar-thumb-hover": "#98aa8e",
		"--scrollbar-size": "8px",

		"--bg-surface": "#1e2a1e",
		"--bg-card-rgb": "18,26,18",
		"--surface-rgb": "255, 255, 255",
		"--surface-card": "var(--bg-card)",
		"--surface-input": "var(--bg-input)",
		"--surface-dropdown": "#1e2a1e",
		"--surface-hover": "#233020",
		"--surface-active": "#293626",
		"--surface-selected": "#293626",
		"--toast-bg": "#1e2a1e",
		"--toast-border": "var(--border-color)",
		"--text-tertiary": "#98aa8e",

		"--market-hover-bg": "#1b2819",
		"--market-border": "var(--border-color)",
		"--market-text-secondary": "var(--text-secondary)",

		"--font-family": "Cantarell, sans-serif",
		"--font-size-base": "14px",
		"--font-size-sm": "12px",
		"--font-size-label": "11px",
		"--font-size-lg": "16px"
	}
}
