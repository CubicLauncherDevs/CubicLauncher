{
	"name": "Halloween 2026 (u/Ercerus)",
	"author": "CubicLauncher",
	"version": "1.0",
	"type": "builtin",
	"bg_image": "/themes/halloween-2026/halloween-2026.webp",
	"bg_image_blur": 0,
	"bg_image_opacity": 0.55,
	"variables": {
		"--color-scheme": "dark",
		"--bg-image-brightness": "0.8",
		"--bg-image-size": "cover",
		"--bg-image-position": "center",

		"--bg-main": "#0a0d1a",
		"--bg-sidebar": "#0e1224",
		"--bg-card": "#151a30",
		"--bg-item-active": "#212845",
		"--bg-overlay": "rgba(6,8,18,0.78)",
		"--bg-input": "#1a1f38",

		"--bg-sidebar-gradient": "linear-gradient(180deg, #121632 0%, #0a0d1a 100%)",
		"--bg-card-gradient": "linear-gradient(135deg, rgba(255,138,43,0.08) 0%, rgba(124,92,200,0.05) 100%)",

		"--text-primary": "#f2ece0",
		"--text-secondary": "#c8c3d6",
		"--text-muted": "#948fa8",
		"--text-tertiary": "#948fa8",

		"--border": "var(--border-color)",
		"--border-color": "#2b3252",
		"--border-hover": "#444d78",
		"--border-focus": "var(--accent)",
		"--control-focus-shadow": "0 0 0 3px rgba(255,138,43,0.28)",
		"--border-width": "1px",
		"--border-radius": "8px",
		"--border-radius-sm": "4px",
		"--border-radius-lg": "12px",

		"--accent": "#ff8a2b",
		"--accent-rgb": "255,138,43",
		"--accent-hover": "#ffa653",
		"--accent-text": "#1a0f04",
		"--accent-primary": "#ff8a2b",

		"--shadow-sm": "0 1px 3px rgba(2,4,12,0.55)",
		"--shadow-md": "0 4px 12px rgba(2,4,12,0.6)",
		"--shadow-lg": "0 8px 28px rgba(2,4,12,0.7)",
		"--glow-accent": "0 0 14px rgba(255,138,43,0.3)",
		"--glow-error": "0 0 12px rgba(var(--color-error-rgb),0.3)",
		"--glow-success": "0 0 12px rgba(var(--color-success-rgb),0.25)",

		"--color-success": "#6bbf59",
		"--color-success-rgb": "107,191,89",
		"--color-error": "#ff5a4d",
		"--color-error-rgb": "255,90,77",
		"--color-warning": "#ffb020",
		"--color-warning-rgb": "255,176,32",
		"--color-info": "#9d84e8",
		"--color-info-rgb": "157,132,232",
		"--color-on-success": "#0a0d1a",
		"--color-on-error": "#0a0d1a",
		"--color-on-warning": "#1a0f04",
		"--color-on-info": "#0a0d1a",
		"--color-status-starting": "var(--color-info)",
		"--color-status-started": "#6bbf59",

		"--icon-filter": "invert(1)",
		"--icon-filter-error": "invert(16%) sepia(89%) saturate(4668%) hue-rotate(0deg) brightness(96%) contrast(112%)",
		"--cubic-logo": "url(\"/images/cubic-white.svg\")",
		"--cubic-logo-fallback": "url(\"/images/cubic-white.svg\")",

		"--clr-loader-vanilla": "#7f8bb0",
		"--clr-loader-fabric": "#6bbf59",
		"--clr-loader-forge": "#ff8a2b",
		"--clr-loader-quilt": "#9d84e8",

		"--sidebar-width": "260px",

		"--scrollbar-track": "#0a0d1a",
		"--scrollbar-thumb": "#3a4266",
		"--scrollbar-thumb-hover": "#ff8a2b",
		"--scrollbar-size": "8px",

		"--bg-surface": "#1b2138",
		"--bg-card-rgb": "21,26,48",
		"--surface-rgb": "255, 255, 255",
		"--surface-subtle": "rgba(255,255,255,0.04)",
		"--surface-raised": "rgba(255,255,255,0.06)",
		"--surface-card": "var(--bg-card)",
		"--surface-input": "var(--bg-input)",
		"--surface-dropdown": "#1b2138",
		"--surface-hover": "#212845",
		"--surface-active": "#2a3152",
		"--surface-selected": "var(--bg-item-active)",
		"--toast-bg": "#1a1f38",
		"--toast-border": "var(--border-color)",

		"--market-hover-bg": "#212845",
		"--market-border": "var(--border-color)",
		"--market-text-secondary": "var(--text-secondary)",
		"--market-success": "#6bbf59",
		"--market-info": "#9d84e8",

		"--font-family": "Cantarell, sans-serif",
		"--font-size-base": "14px",
		"--font-size-sm": "12px",
		"--font-size-label": "11px",
		"--font-size-lg": "16px"
	}
}
