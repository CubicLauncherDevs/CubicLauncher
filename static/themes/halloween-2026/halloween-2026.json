{
	"name": "Halloween 2026",
	"author": "CubicLauncher",
	"version": "1.0",
	"type": "builtin",
	"bg_image": "/themes/halloween-2026/halloween-2026.svg",
	"bg_image_blur": 3.0,
	"bg_image_opacity": 0.42,
	"variables": {
		"--color-scheme": "dark",
		"--bg-image-brightness": "0.6",
		"--bg-image-size": "cover",
		"--bg-image-position": "center",

		"--bg-main": "#0a0a0c",
		"--bg-sidebar": "#121214",
		"--bg-card": "#1a1a1e",
		"--bg-item-active": "#26262c",
		"--bg-overlay": "rgba(0,0,0,0.75)",
		"--bg-input": "#1e1e22",

		"--bg-sidebar-gradient": "linear-gradient(180deg, #141416 0%, #0a0a0c 100%)",
		"--bg-card-gradient": "linear-gradient(135deg, rgba(255,122,24,0.06) 0%, rgba(0,0,0,0) 100%)",

		"--text-primary": "#f5efe6",
		"--text-secondary": "#cbc3b8",
		"--text-muted": "#9b938a",
		"--text-tertiary": "#9b938a",

		"--border": "var(--border-color)",
		"--border-color": "#3a3a42",
		"--border-hover": "#5b5b66",
		"--border-focus": "var(--accent)",
		"--control-focus-shadow": "0 0 0 3px rgba(255,122,24,0.28)",
		"--border-width": "1px",
		"--border-radius": "8px",
		"--border-radius-sm": "4px",
		"--border-radius-lg": "12px",

		"--accent": "#ff7a18",
		"--accent-rgb": "255,122,24",
		"--accent-hover": "#ff9440",
		"--accent-text": "#1a0e04",
		"--accent-primary": "#ff7a18",

		"--shadow-sm": "0 1px 3px rgba(0,0,0,0.5)",
		"--shadow-md": "0 4px 12px rgba(0,0,0,0.6)",
		"--shadow-lg": "0 8px 28px rgba(0,0,0,0.7)",
		"--glow-accent": "0 0 14px rgba(255,122,24,0.28)",
		"--glow-error": "0 0 12px rgba(var(--color-error-rgb),0.3)",
		"--glow-success": "0 0 12px rgba(var(--color-success-rgb),0.25)",

		"--color-success": "#6bbf59",
		"--color-success-rgb": "107,191,89",
		"--color-error": "#ff5a4d",
		"--color-error-rgb": "255,90,77",
		"--color-warning": "#ffb020",
		"--color-warning-rgb": "255,176,32",
		"--color-info": "#b07cff",
		"--color-info-rgb": "176,124,255",
		"--color-on-success": "#0a0a0c",
		"--color-on-error": "#0a0a0c",
		"--color-on-warning": "#1a0e04",
		"--color-on-info": "#0a0a0c",
		"--color-status-starting": "var(--color-info)",
		"--color-status-started": "#6bbf59",

		"--icon-filter": "invert(1)",
		"--icon-filter-error": "invert(16%) sepia(89%) saturate(4668%) hue-rotate(0deg) brightness(96%) contrast(112%)",
		"--cubic-logo": "url(\"/images/cubic-white.svg\")",
		"--cubic-logo-fallback": "url(\"/images/cubic-white.svg\")",

		"--clr-loader-vanilla": "#78909c",
		"--clr-loader-fabric": "#6bbf59",
		"--clr-loader-forge": "#ff7a18",
		"--clr-loader-quilt": "#b07cff",

		"--sidebar-width": "260px",

		"--scrollbar-track": "#0a0a0c",
		"--scrollbar-thumb": "#4a4a52",
		"--scrollbar-thumb-hover": "#ff7a18",
		"--scrollbar-size": "8px",

		"--bg-surface": "#202026",
		"--bg-card-rgb": "26,26,30",
		"--surface-rgb": "255, 255, 255",
		"--surface-subtle": "rgba(255,255,255,0.03)",
		"--surface-raised": "rgba(255,255,255,0.05)",
		"--surface-card": "var(--bg-card)",
		"--surface-input": "var(--bg-input)",
		"--surface-dropdown": "#202026",
		"--surface-hover": "#26262c",
		"--surface-active": "#2e2e36",
		"--surface-selected": "var(--bg-item-active)",
		"--toast-bg": "#1e1e22",
		"--toast-border": "var(--border-color)",

		"--market-hover-bg": "#242428",
		"--market-border": "var(--border-color)",
		"--market-text-secondary": "var(--text-secondary)",
		"--market-success": "#6bbf59",
		"--market-info": "#b07cff",

		"--font-family": "Cantarell, sans-serif",
		"--font-size-base": "14px",
		"--font-size-sm": "12px",
		"--font-size-label": "11px",
		"--font-size-lg": "16px"
	}
}
