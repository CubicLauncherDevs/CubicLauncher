{
	"name": "Rosé Pine",
	"author": "CubicLauncher",
	"version": "1.1",
	"type": "builtin",
	"bg_image": "/themes/rose-pine/rose-pine.webp",
	"bg_image_blur": 0.0,
	"bg_image_opacity": 0.15,
	"variables": {
		"--color-scheme": "dark",
		"--bg-image-brightness": "0.4",
		"--bg-main": "#191724",
		"--bg-sidebar": "#1f1d2e",
		"--bg-card": "#1f1d2e",
		"--bg-item-active": "#26233a",
		"--bg-overlay": "rgba(25,23,36,0.75)",
		"--bg-input": "#26233a",

		"--bg-sidebar-gradient": "linear-gradient(180deg, #1f1d2e 0%, #191724 100%)",
		"--bg-card-gradient": "linear-gradient(135deg, rgba(235,188,186,0.05) 0%, rgba(0,0,0,0) 100%)",

		"--text-primary": "#e0def4",
		"--text-secondary": "#c1bcd4",
		"--text-muted": "#aaa5c2",
		"--text-tertiary": "#aaa5c2",

		"--border": "var(--border-color)",
		"--border-color": "#514963",
		"--border-hover": "#7a708d",
		"--border-focus": "var(--accent)",
		"--control-focus-shadow": "0 0 0 3px rgba(235,188,186,0.2)",
		"--border-width": "1px",
		"--border-radius": "8px",
		"--border-radius-sm": "4px",
		"--border-radius-lg": "12px",

		"--accent": "#ebbcba",
		"--accent-rgb": "235,188,186",
		"--accent-hover": "#f0cec9",
		"--accent-text": "#191724",
		"--accent-primary": "#ebbcba",

		"--shadow-sm": "0 1px 3px rgba(0,0,0,0.4)",
		"--shadow-md": "0 4px 12px rgba(0,0,0,0.5)",
		"--shadow-lg": "0 8px 28px rgba(0,0,0,0.6)",
		"--glow-accent": "0 0 12px rgba(235,188,186,0.18)",
		"--glow-error": "0 0 12px rgba(var(--color-error-rgb),0.25)",
		"--glow-success": "0 0 12px rgba(var(--color-success-rgb),0.25)",

		"--color-success": "#9ccfd8",
		"--color-success-rgb": "156,207,216",
		"--color-error": "#f080a0",
		"--color-error-rgb": "240,128,160",
		"--color-warning": "#f6c177",
		"--color-warning-rgb": "246,193,119",
		"--color-info": "#c4a7e7",
		"--color-info-rgb": "196,167,231",
		"--color-on-success": "#191724",
		"--color-on-error": "#191724",
		"--color-on-warning": "#191724",
		"--color-on-info": "#191724",
		"--color-status-starting": "var(--color-info)",
		"--color-status-started": "#9ccfd8",

		"--icon-filter": "brightness(0) saturate(100%) invert(100%)",
		"--icon-filter-error": "invert(16%) sepia(89%) saturate(4668%) hue-rotate(0deg) brightness(96%) contrast(112%)",
		"--cubic-logo": "url(\"/images/cubic-white.svg\")",
		"--cubic-logo-fallback": "url(\"/images/cubic-white.svg\")",

		"--clr-loader-vanilla": "#908caa",
		"--clr-loader-fabric": "#9ccfd8",
		"--clr-loader-forge": "#f6c177",
		"--clr-loader-quilt": "#c4a7e7",

		"--sidebar-width": "260px",

		"--scrollbar-track": "#191724",
		"--scrollbar-thumb": "#7a708d",
		"--scrollbar-thumb-hover": "#aaa5c2",
		"--scrollbar-size": "8px",

		"--bg-surface": "#26233a",
		"--bg-card-rgb": "31,29,46",
		"--surface-rgb": "255, 255, 255",
		"--surface-card": "var(--bg-card)",
		"--surface-input": "var(--bg-input)",
		"--surface-dropdown": "#26233a",
		"--surface-hover": "#302b43",
		"--surface-active": "#363047",
		"--surface-selected": "#363047",
		"--toast-bg": "#26233a",
		"--toast-border": "var(--border-color)",

		"--market-hover-bg": "#2a263e",
		"--market-border": "var(--border-color)",
		"--market-text-secondary": "var(--text-secondary)",
		"--market-success": "#9ccfd8",
		"--market-info": "#c4a7e7",

		"--font-family": "Cantarell, sans-serif",
		"--font-size-base": "14px",
		"--font-size-sm": "12px",
		"--font-size-label": "11px",
		"--font-size-lg": "16px"
	}
}
