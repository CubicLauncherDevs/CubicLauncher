{
	"name": "Rosé Pine Dawn",
	"author": "CubicLauncher",
	"version": "1.1",
	"type": "builtin",
	"bg_image": "/themes/rose-pine-dawn/rose-pine-dawn.webp",
	"bg_image_blur": 0.0,
	"bg_image_opacity": 0.06,
	"variables": {
		"--color-scheme": "light",
		"--bg-image-brightness": "1",
		"--bg-main": "#faf4ed",
		"--bg-sidebar": "#fffaf3",
		"--bg-card": "#fffaf3",
		"--bg-item-active": "#f2e9e1",
		"--bg-overlay": "rgba(87,82,121,0.35)",
		"--bg-input": "#f2e9e1",

		"--bg-sidebar-gradient": "linear-gradient(180deg, #fffaf3 0%, #faf4ed 100%)",
		"--bg-card-gradient": "linear-gradient(135deg, rgba(215,130,122,0.05) 0%, rgba(0,0,0,0) 100%)",

		"--text-primary": "#575279",
		"--text-secondary": "#625875",
		"--text-muted": "#645b73",
		"--text-tertiary": "#645b73",

		"--border": "var(--border-color)",
		"--border-color": "#b9a8a6",
		"--border-hover": "#907d85",
		"--border-focus": "var(--accent)",
		"--control-focus-shadow": "0 0 0 3px rgba(163,76,70,0.18)",
		"--border-width": "1px",
		"--border-radius": "8px",
		"--border-radius-sm": "4px",
		"--border-radius-lg": "12px",

		"--accent": "#a34c46",
		"--accent-rgb": "163,76,70",
		"--accent-hover": "#8e403b",
		"--accent-text": "#fffaf3",
		"--accent-primary": "var(--accent)",

		"--shadow-sm": "0 1px 3px rgba(87,82,121,0.08)",
		"--shadow-md": "0 4px 12px rgba(87,82,121,0.1)",
		"--shadow-lg": "0 8px 28px rgba(87,82,121,0.12)",
		"--shadow-drawer-left": "-8px 0 32px rgba(87,82,121,0.12)",
		"--shadow-drawer-right": "8px 0 32px rgba(87,82,121,0.12)",
		"--shadow-drawer-top": "0 -8px 32px rgba(87,82,121,0.12)",
		"--shadow-drawer-bottom": "0 8px 32px rgba(87,82,121,0.12)",
		"--glow-accent": "0 0 12px rgba(var(--accent-rgb),0.2)",
		"--glow-error": "0 0 12px rgba(var(--color-error-rgb),0.2)",
		"--glow-success": "0 0 12px rgba(40,105,131,0.2)",

		"--color-success": "#286983",
		"--color-success-rgb": "40,105,131",
		"--color-error": "#9d3f5a",
		"--color-error-rgb": "157,63,90",
		"--color-warning": "#80500c",
		"--color-warning-rgb": "128,80,12",
		"--color-info": "#315f87",
		"--color-info-rgb": "49,95,135",
		"--color-on-success": "#fffaf3",
		"--color-on-error": "#fffaf3",
		"--color-on-warning": "#fffaf3",
		"--color-on-info": "#fffaf3",
		"--color-status-starting": "var(--color-info)",
		"--color-status-started": "var(--color-success)",

		"--icon-filter": "none",
		"--icon-filter-error": "none",
		"--cubic-logo": "url(\"/images/cubic.svg\")",
		"--cubic-logo-fallback": "url(\"/images/cubic.svg\")",

		"--clr-loader-vanilla": "#625875",
		"--clr-loader-fabric": "#286983",
		"--clr-loader-forge": "#80500c",
		"--clr-loader-quilt": "#70568e",
		"--download-library": "var(--color-success)",
		"--download-asset": "var(--color-info)",
		"--download-native": "var(--color-warning)",
		"--download-client": "#70568e",
		"--download-verifying": "var(--color-error)",
		"--download-generic": "var(--text-secondary)",
		"--download-processing": "#975027",
		"--download-jre": "#286983",

		"--sidebar-width": "260px",

		"--scrollbar-track": "#faf4ed",
		"--scrollbar-thumb": "#907d85",
		"--scrollbar-thumb-hover": "#645b73",
		"--scrollbar-size": "8px",

		"--bg-surface": "#f2e9e1",
		"--bg-card-rgb": "255,250,243",
		"--surface-rgb": "0, 0, 0",
		"--surface-card": "var(--bg-card)",
		"--surface-input": "var(--bg-input)",
		"--surface-dropdown": "#fffaf3",
		"--surface-hover": "#f0e4dc",
		"--surface-active": "#e8dcd4",
		"--surface-selected": "#e8dcd4",
		"--toast-bg": "#fffaf3",
		"--toast-border": "var(--border-color)",

		"--market-hover-bg": "#f5ede7",
		"--market-border": "var(--border-color)",
		"--market-text-secondary": "var(--text-secondary)",
		"--market-accent": "var(--accent)",
		"--market-accent-hover": "var(--accent-hover)",
		"--market-error": "var(--color-error)",
		"--market-warning": "var(--color-warning)",
		"--market-info": "var(--color-info)",

		"--font-family": "Cantarell, sans-serif",
		"--font-size-base": "14px",
		"--font-size-sm": "12px",
		"--font-size-label": "11px",
		"--font-size-lg": "16px"
	}
}
