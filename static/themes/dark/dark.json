{
	"name": "Oscuro",
	"author": "CubicLauncher",
	"version": "1.0",
	"type": "builtin",
	"bg_image": "/themes/dark/dark.webp",
	"bg_image_blur": 5.0,
	"bg_image_opacity": 0.2,
	"variables": {
		"--bg-main": "#0c0c0c",
		"--bg-sidebar": "#0f1010",
		"--bg-card": "#16161a",
		"--bg-item-active": "#1c1d1d",
		"--bg-overlay": "rgba(0,0,0,0.7)",
		"--bg-input": "#1c1c1c",

		"--bg-sidebar-gradient": "linear-gradient(180deg, #0f1010 0%, #0c0c0c 100%)",
		"--bg-card-gradient": "linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0) 100%)",

		"--text-primary": "#d8d8d8",
		"--text-secondary": "#909090",
		"--text-muted": "#787878",
		"--text-tertiary": "#888888",

		"--border": "var(--border-color)",
		"--border-color": "#242424",
		"--border-hover": "#383838",
		"--border-focus": "#777777",
		"--control-focus-shadow": "0 0 0 2px rgba(255,255,255,0.06)",
		"--border-width": "1px",
		"--border-radius": "8px",
		"--border-radius-sm": "4px",
		"--border-radius-lg": "12px",

		"--accent": "#ffffff",
		"--accent-rgb": "255,255,255",
		"--accent-hover": "#e0e0e0",
		"--accent-text": "#0c0c0c",
		"--accent-primary": "#ffffff",

		"--shadow-sm": "0 1px 3px rgba(0,0,0,0.4)",
		"--shadow-md": "0 4px 12px rgba(0,0,0,0.5)",
		"--shadow-lg": "0 8px 28px rgba(0,0,0,0.6)",
		"--glow-accent": "0 0 12px rgba(255,255,255,0.15)",
		"--glow-error": "0 0 12px rgba(248,81,73,0.3)",
		"--glow-success": "0 0 12px rgba(63,185,80,0.3)",

		"--color-success": "#3fb950",
		"--color-success-rgb": "63,185,80",
		"--color-error": "#f85149",
		"--color-error-rgb": "248,81,73",
		"--color-warning": "#d29922",
		"--color-warning-rgb": "210,153,34",
		"--color-status-starting": "#8ab4e8",
		"--color-status-started": "#8fbc8f",
		"--icon-filter": "invert(1)",
		"--icon-filter-error": "invert(16%) sepia(89%) saturate(4668%) hue-rotate(0deg) brightness(96%) contrast(112%)",
		"--cubic-logo": "url(\"/images/cubic-white.svg\")",
		"--cubic-logo-fallback": "url(\"/images/cubic-white.svg\")",

		"--clr-loader-vanilla": "#78909c",
		"--clr-loader-fabric": "#66bb6a",
		"--clr-loader-forge": "#ffa726",
		"--clr-loader-quilt": "#c77dd6",

		"--sidebar-width": "260px",

		"--scrollbar-track": "#0c0c0c",
		"--scrollbar-thumb": "#383838",
		"--scrollbar-thumb-hover": "#606060",
		"--scrollbar-size": "8px",

		"--bg-surface": "#1e1e1e",
		"--surface-rgb": "255, 255, 255",
		"--surface-subtle": "rgba(255,255,255,0.03)",
		"--surface-raised": "rgba(255,255,255,0.05)",
		"--surface-card": "var(--bg-card)",
		"--surface-input": "var(--bg-input)",
		"--surface-dropdown": "#1e1e1e",
		"--surface-hover": "#242424",
		"--surface-active": "#2c2c2c",
		"--surface-selected": "var(--bg-item-active)",
		"--toast-bg": "#1c1c1c",
		"--toast-border": "var(--border-color)",

		"--font-family": "Cantarell, sans-serif",
		"--font-size-base": "14px",
		"--font-size-sm": "12px",
		"--font-size-label": "11px",
		"--font-size-lg": "16px"
	}
}
